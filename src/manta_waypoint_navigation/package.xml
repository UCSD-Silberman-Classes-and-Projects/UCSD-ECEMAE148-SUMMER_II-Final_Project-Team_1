<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>manta_waypoint_navigation</name>
  <version>0.1.0</version>
  <description>Reporting-only GPS waypoint solution for the MANTA RoboCar.</description>
  <maintainer email="noreply@example.com">MANTA Team 1</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nmea_navsat_driver</exec_depend>
  <exec_depend>bno08x_driver</exec_depend>
  <exec_depend>manta_localization</exec_depend>
  <exec_depend>ucsd_robocar_control2_pkg</exec_depend>
  <exec_depend>ucsd_robocar_actuator2_pkg</exec_depend>
  <exec_depend>ucsd_robocar_sensor2_pkg</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
